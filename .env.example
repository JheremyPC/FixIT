# --- PostgreSQL local (docker compose) ---
POSTGRES_DB=fixit
POSTGRES_USER=fixit
POSTGRES_PASSWORD=change-this-password
# The API uses this URL outside Docker. Inside docker compose the API is pointed at the local
# "db" service (see COMPOSE_DATABASE_URL in docker-compose.yml) unless you override it.
DATABASE_URL=postgresql+psycopg://fixit:change-this-password@db:5432/fixit
# COMPOSE_DATABASE_URL=postgresql+psycopg://...   # optional: other database for docker compose

# --- Security ---
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
FIXIT_ADMIN_PASSWORD=replace-with-the-initial-admin-password
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# --- Hardening (docs/seguridad.md) ---
# Interactive API docs (/docs, /redoc, /openapi.json). Keep false in production.
API_DOCS_ENABLED=false
# Proxies in front of the app that append the client address to X-Forwarded-For (0: use the socket peer).
# Only set it after confirming how many hops your platform adds; a wrong value lets clients spoof their IP.
TRUSTED_PROXY_HOPS=0
# Failed logins per account (and optionally per IP; 0 disables) within the window before a temporary block.
LOGIN_MAX_FAILURES=10
LOGIN_IP_MAX_FAILURES=0
LOGIN_WINDOW_MINUTES=15
# Key for the audit record seals (HMAC-SHA256). Empty: derived from JWT_SECRET_KEY. Set a long random value
# and keep it stable: rotating it leaves older records reported as "CLAVE_DISTINTA".
AUDIT_HMAC_KEY=
AUDIT_EXPORT_MAX_ROWS=50000

# --- Machine Learning ---
# Local cache of trained models; the source of truth is the ml_artifacts table. Default: backend/ml_models
# ML_MODEL_DIR=/srv/fixit/backend/ml_models

# --- Synthetic data (local only) ---
# Password for the demo accounts *@sintetico.fixit.example created by "python -m app.synthetic import"
# FIXIT_SYNTHETIC_PASSWORD=Demo!2026
# Extra host names considered local by the synthetic importer (comma separated)
# FIXIT_LOCAL_DB_HOSTS=

# --- LLM assistant (backend only; never exposed to the browser) ---
# Leave LLM_PROVIDER empty to keep the assistant disabled (it will say so; no simulated answers).
LLM_PROVIDER=
# anthropic: official SDK. Requires LLM_API_KEY (or ANTHROPIC_API_KEY). Default model claude-opus-5-5.
# openai_compatible: any /chat/completions endpoint, e.g. a local Ollama at http://localhost:11434/v1
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, LLM_MODEL=gemini-3.8-flash,
#   LLM_API_KEY=<Google AI Studio key>, LLM_MAX_TOKENS=8192 (Gemini counts its reasoning against this limit)
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Gemini only: alternative model tried when LLM_MODEL still returns HTTP 429/503 after its retries (1 s, 2 s, 4 s or Retry-After).
# Leave empty to disable the fallback.
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
# anthropic: low | medium | high | xhigh | max · Gemini (openai_compatible): minimal | low | medium | high
LLM_EFFORT=low
# anthropic only: "default" enables server-side refusal fallbacks on supported models; "off" disables
LLM_ANTHROPIC_FALLBACKS=default
